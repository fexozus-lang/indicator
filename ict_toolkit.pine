//
// ICT Toolkit — incremental build. Verified working so far:
//   sessions, previous D/W/M, PD arrays, SMT divergence, FVG.   To add: CISD.
// Levels use plot() rather than line objects, so they cannot be evicted by
// TradingView's 500-drawing cap and cannot be hidden off-screen.
indicator("ICT Toolkit (build)", shorttitle = "ICT Build", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     max_bars_back = 1000)

const string G_FVG = "Fair Value Gaps (LuxAlgo)"
const string G_SES = "Sessions"
const string G_HTF = "Previous D / W / M"
const string G_PD  = "PD Array"
const string G_SMT = "SMT Divergence"
const string G_GEN = "Dashboard"

// ── Fair Value Gaps ──────────────────────────────────────────────────────────
fvgShow     = input.bool(true, "Show FVG",              group = G_FVG)
fvgThresh   = input.float(0, "Threshold %", minval = 0, maxval = 100, step = .1, group = G_FVG, inline = "th")
fvgAuto     = input.bool(false, "Auto",                 group = G_FVG, inline = "th", tooltip = "Auto uses the running average of (high-low)/low as the minimum gap size.")
fvgShowLast = input.int(0, "Unmitigated levels", minval = 0, group = G_FVG, tooltip = "Draw a level at the edge of the N most recent unmitigated gaps. 0 = off.")
fvgMitLines = input.bool(false, "Mitigation levels",    group = G_FVG, tooltip = "Leave a line behind at the edge of each gap as it is mitigated.")
fvgTf       = input.timeframe("", "Timeframe",          group = G_FVG, tooltip = "Blank = chart timeframe. Set higher to overlay HTF gaps.")
fvgExt      = input.int(20, "Extend", minval = 0,       group = G_FVG, inline = "ex")
fvgDynamic  = input.bool(false, "Dynamic",              group = G_FVG, inline = "ex", tooltip = "Dynamic shows only the newest gap in each direction, shrinking as price fills it, instead of drawing every gap as a box.")
fvgMaxKeep  = input.int(100, "Max gaps kept", minval = 1, maxval = 400, group = G_FVG)
fvgBordOn   = input.bool(false, "Zone border",          group = G_FVG, inline = "fb")
fvgBordSt   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G_FVG, inline = "fb")
fvgBordW    = input.int(1, "W",                         group = G_FVG, inline = "fb", minval = 1, maxval = 4)
fvgMitSt    = input.string("Dashed", "Mitigation line", options = ["Solid", "Dashed", "Dotted"], group = G_FVG, inline = "fm")
fvgMitW     = input.int(1, "W",                         group = G_FVG, inline = "fm", minval = 1, maxval = 4)
fvgUnmSt    = input.string("Solid", "Unmitigated line", options = ["Solid", "Dashed", "Dotted"], group = G_FVG, inline = "fu")
fvgUnmW     = input.int(1, "W",                         group = G_FVG, inline = "fu", minval = 1, maxval = 4)
bullCss     = input.color(color.new(#089981, 70), "Bullish FVG", group = G_FVG)
bearCss     = input.color(color.new(#f23645, 70), "Bearish FVG", group = G_FVG)

// ── Sessions ─────────────────────────────────────────────────────────────────
sesShow   = input.bool(true, "Show sessions",           group = G_SES)
sesTz     = input.string("America/New_York", "Timezone", group = G_SES)
sesKeep   = input.int(10, "Sessions kept per type",     group = G_SES, minval = 1, maxval = 50)

sesBoxOn  = input.bool(true, "Session boxes",           group = G_SES, inline = "bx")
sesFillTr = input.int(85,    "Fill transp",             group = G_SES, inline = "bx", minval = 0, maxval = 100)

sesLineOn = input.bool(true, "Session high/low lines",  group = G_SES)
sesLineSt = input.string("Dotted", "H/L line", options = ["Solid", "Dashed", "Dotted"], group = G_SES, inline = "hl")
sesLineWd = input.int(1,     "W",                       group = G_SES, inline = "hl", minval = 1, maxval = 4)
sesExt    = input.string("Until next session", "Extend",
     options = ["While session is open", "Until next session", "To right edge"], group = G_SES)
sesLbl    = input.bool(true, "Label session high/low",  group = G_SES, inline = "lb")
sesLblCol = input.color(#b2b5be, "",                    group = G_SES, inline = "lb")
sesLblWhich = input.string("Newest only", "Label", options = ["Newest only", "All kept sessions"], group = G_SES, inline = "lb2")
sesLblSize  = input.string("Tiny", "", options = ["Tiny", "Small", "Normal"], group = G_SES, inline = "lb2")
sesLblPx    = input.bool(false, "Include price in label", group = G_SES)

s1On = input.bool(true, "Asia",   group = G_SES, inline = "a")
s1T  = input.session("2000-0000", "", group = G_SES, inline = "a")
s1C  = input.color(#9c27b0, "",       group = G_SES, inline = "a")
s2On = input.bool(true, "London", group = G_SES, inline = "b")
s2T  = input.session("0200-0500", "", group = G_SES, inline = "b")
s2C  = input.color(#2962ff, "",       group = G_SES, inline = "b")
s3On = input.bool(true, "NY AM",  group = G_SES, inline = "c")
s3T  = input.session("0930-1100", "", group = G_SES, inline = "c")
s3C  = input.color(#ff9800, "",       group = G_SES, inline = "c")
s4On = input.bool(true, "NY PM",  group = G_SES, inline = "d")
s4T  = input.session("1330-1600", "", group = G_SES, inline = "d")
s4C  = input.color(#607d8b, "",       group = G_SES, inline = "d")

// ── Previous D / W / M ───────────────────────────────────────────────────────
pdOn  = input.bool(true,  "Prev Day H/L",   group = G_HTF, inline = "h1")
pdC   = input.color(#787b86, "",            group = G_HTF, inline = "h1")
pdW   = input.int(1, "W",                   group = G_HTF, inline = "h1", minval = 1, maxval = 4)
pwOn  = input.bool(true,  "Prev Week H/L",  group = G_HTF, inline = "h2")
pwC   = input.color(#2962ff, "",            group = G_HTF, inline = "h2")
pwW   = input.int(1, "W",                   group = G_HTF, inline = "h2", minval = 1, maxval = 4)
pmOn  = input.bool(false, "Prev Month H/L", group = G_HTF, inline = "h3")
pmC   = input.color(#9c27b0, "",            group = G_HTF, inline = "h3")
pmW   = input.int(2, "W",                   group = G_HTF, inline = "h3", minval = 1, maxval = 4)

// ── PD array ─────────────────────────────────────────────────────────────────
pdaOn    = input.bool(true, "Show PD array", group = G_PD)
pdaRange = input.string("Previous Day", "Range",
     options = ["Previous Day", "Previous Week", "Previous Month", "Current Day"], group = G_PD)
pdaBndC  = input.color(#787b86, "Boundary 0.0 / 1.0", group = G_PD)
pdaEqC   = input.color(#f23645, "Equilibrium 0.5",    group = G_PD)
pdaOteC  = input.color(#089981, "OTE 0.705 / 0.295",  group = G_PD)
pdaSubOn = input.bool(true, "Show 0.618 / 0.382",     group = G_PD, inline = "ps")
pdaSubC  = input.color(#b2b5be, "",                   group = G_PD, inline = "ps")

// ── SMT divergence ───────────────────────────────────────────────────────────
smtShow    = input.bool(true, "Show SMT divergence",   group = G_SMT)
smtPiv     = input.int(3,  "Swing pivot length",       group = G_SMT, minval = 1, tooltip = "A pivot is only confirmed this many bars after it prints -- that lag is inherent to swing detection. Smaller = faster and noisier.")
smtMaxGap  = input.int(100, "Max bars between swings", group = G_SMT, minval = 0, tooltip = "Ignore a divergence when the two swings are further apart than this. 0 = no limit.")
smt1On     = input.bool(true,  "Correlated symbol 1",  group = G_SMT, inline = "s1")
smt1Sym    = input.symbol("CME_MINI:ES1!", "",         group = G_SMT, inline = "s1")
smt2On     = input.bool(false, "Correlated symbol 2",  group = G_SMT, inline = "s2")
smt2Sym    = input.symbol("CBOT_MINI:YM1!", "",        group = G_SMT, inline = "s2")
smtKeep    = input.int(20, "Max SMT marks kept",       group = G_SMT, minval = 1, maxval = 100)
smtStyle   = input.string("Solid", "Connector", options = ["Solid", "Dashed", "Dotted"], group = G_SMT, inline = "sl")
smtWidth   = input.int(1,  "W",                        group = G_SMT, inline = "sl", minval = 1, maxval = 4)
smtTag     = input.string("SMT", "Label text",         group = G_SMT, inline = "st")
smtLblSize = input.string("Tiny", "", options = ["Tiny", "Small", "Normal"], group = G_SMT, inline = "st")
smtAutoCol = input.bool(true, "Match chart text colour", group = G_SMT, tooltip = "Draws in the chart's foreground colour so it reads on light and dark themes.")
smtBearCol = input.color(#f23645, "At highs",          group = G_SMT, inline = "sc")
smtBullCol = input.color(#089981, "At lows",           group = G_SMT, inline = "sc")

// ── Dashboard ────────────────────────────────────────────────────────────────
dashOn     = input.bool(true, "Show status table", group = G_GEN)
dashPos    = input.string("Bottom right", "Position",
     options = ["Bottom right", "Bottom left", "Top right", "Top left"], group = G_GEN)
dashTxtCol = input.color(#e0e3eb, "Text",       group = G_GEN, inline = "d")
dashBgCol  = input.color(#1e222d, "Background", group = G_GEN, inline = "d")

lblSize(string name) =>
    switch name
        "Normal" => size.normal
        "Small"  => size.small
        => size.tiny

lineStyle(string name) =>
    switch name
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// ═════════════════════════════════════════════════════════════════════════════
// Sessions
// ═════════════════════════════════════════════════════════════════════════════
// "Am I in the session" and "did it just start" are computed at GLOBAL scope.
// Referencing [1] on a variable local to a function is what makes Pine unable
// to size its history buffer, so it is deliberately avoided here.
inA = sesShow and s1On and not na(time(timeframe.period, s1T, sesTz))
inL = sesShow and s2On and not na(time(timeframe.period, s2T, sesTz))
inM = sesShow and s3On and not na(time(timeframe.period, s3T, sesTz))
inP = sesShow and s4On and not na(time(timeframe.period, s4T, sesTz))

newA = inA and not inA[1]
newL = inL and not inL[1]
newM = inM and not inM[1]
newP = inP and not inP[1]

sessDraw(bool active, bool isNew, color col, string nm) =>
    var array<box>   bxs = array.new<box>()
    var array<line>  lns = array.new<line>()
    var array<label> lbs = array.new<label>()
    var box   bx   = na
    var line  lh   = na
    var line  ll   = na
    var label lbH  = na
    var label lbL  = na
    var float hi   = na
    var float lo   = na
    var int   sBar = na
    var int   eBar = na

    if isNew
        hi   := high
        lo   := low
        sBar := bar_index
        eBar := bar_index
        if sesBoxOn
            bx := box.new(bar_index, high, bar_index, low, border_color = color.new(col, 40),
                 bgcolor = color.new(col, sesFillTr), text = nm, text_size = size.tiny,
                 text_color = color.new(col, 25))
            array.push(bxs, bx)
            if array.size(bxs) > sesKeep
                box.delete(array.shift(bxs))
        if sesLineOn
            ext = sesExt == "To right edge" ? extend.right : extend.none
            lh := line.new(bar_index, high, bar_index, high, color = col,
                 style = lineStyle(sesLineSt), width = sesLineWd, extend = ext)
            ll := line.new(bar_index, low,  bar_index, low,  color = col,
                 style = lineStyle(sesLineSt), width = sesLineWd, extend = ext)
            array.push(lns, lh)
            array.push(lns, ll)
            if array.size(lns) > sesKeep * 2
                line.delete(array.shift(lns))
                line.delete(array.shift(lns))
        // Labels are independent of the lines -- you can have either, both or
        // neither. Older labels stop being updated once a new session starts,
        // so they simply freeze holding that session's final high and low.
        if sesLbl
            lbH := label.new(bar_index, high, "", style = label.style_none,
                 textcolor = sesLblCol, size = lblSize(sesLblSize))
            lbL := label.new(bar_index, low,  "", style = label.style_none,
                 textcolor = sesLblCol, size = lblSize(sesLblSize))
            array.push(lbs, lbH)
            array.push(lbs, lbL)
            int cap = sesLblWhich == "All kept sessions" ? sesKeep * 2 : 2
            if array.size(lbs) > cap
                label.delete(array.shift(lbs))
                label.delete(array.shift(lbs))
    else if active
        hi := math.max(hi, high)
        lo := math.min(lo, low)
        if not na(bx)
            box.set_top(bx, hi)
            box.set_bottom(bx, lo)
            box.set_right(bx, bar_index)

    // How far this session's high and low reach to the right.
    if active or sesExt == "Until next session"
        eBar := bar_index

    if not na(lh)
        line.set_xy1(lh, sBar, hi)
        line.set_xy2(lh, eBar, hi)
        line.set_xy1(ll, sBar, lo)
        line.set_xy2(ll, eBar, lo)

    if not na(lbH)
        int lx = sesExt == "To right edge" ? bar_index + 3 : eBar + 3
        label.set_xy(lbH, lx, hi)
        label.set_xy(lbL, lx, lo)
        label.set_text(lbH, nm + " H" + (sesLblPx ? "  " + str.tostring(hi, format.mintick) : ""))
        label.set_text(lbL, nm + " L" + (sesLblPx ? "  " + str.tostring(lo, format.mintick) : ""))
    active

sessDraw(inA, newA, s1C, "Asia")
sessDraw(inL, newL, s2C, "London")
sessDraw(inM, newM, s3C, "NY AM")
sessDraw(inP, newP, s4C, "NY PM")

activeSes = inA ? "Asia" : inL ? "London" : inM ? "NY AM" : inP ? "NY PM" : "—"

// ═════════════════════════════════════════════════════════════════════════════
// Fair Value Gaps
// ═════════════════════════════════════════════════════════════════════════════
// Adapted from "Fair Value Gap [LuxAlgo]" © LuxAlgo, CC BY-NC-SA 4.0.
// The detection (threshold / auto sizing), the dynamic single-zone mode, and the
// mitigation and unmitigated level treatments are LuxAlgo's design. Changes here:
// identifiers renamed to avoid clashing with the rest of this script (notably
// `extend`, a Pine namespace the session lines use), the stats folded into this
// script's own status table, style inputs added, and the record list capped so
// gap boxes cannot evict other modules' drawings.
type fvg
    float max
    float min
    bool  isbull
    int   t = time

method tosolid(color id) => color.rgb(color.r(id), color.g(id), color.b(id))

fvgDetect() =>
    var fvg found = fvg.new(na, na, na, na)
    threshold = fvgAuto ? ta.cum((high - low) / low) / bar_index : fvgThresh / 100

    bull = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > threshold
    bear = high < low[2] and close[1] < low[2] and (low[2] - high) / high > threshold

    if bull
        found := fvg.new(low, high[2], true)
    else if bear
        found := fvg.new(low[2], high, false)

    [bull, bear, found]

var float maxBullFvg    = na
var float minBullFvg    = na
var float maxBearFvg    = na
var float minBearFvg    = na
var int   bullCount     = 0
var int   bearCount     = 0
var int   bullMitigated = 0
var int   bearMitigated = 0
var int   lastFvgT      = 0

var array<fvg> fvgRecords = array.new<fvg>(0)
var array<box> fvgAreas   = array.new<box>(0)

[bullFvg, bearFvg, newFvg] = request.security(syminfo.tickerid, fvgTf, fvgDetect())

if fvgShow
    // Bullish
    if bullFvg and newFvg.t != lastFvgT
        if fvgDynamic
            maxBullFvg := newFvg.max
            minBullFvg := newFvg.min
        else
            fvgAreas.unshift(box.new(bar_index - 2, newFvg.max, bar_index + fvgExt, newFvg.min,
                 border_color = fvgBordOn ? bullCss.tosolid() : na,
                 border_width = fvgBordW, border_style = lineStyle(fvgBordSt), bgcolor = bullCss))
        fvgRecords.unshift(newFvg)
        bullCount += 1
        lastFvgT  := newFvg.t
    else if fvgDynamic
        maxBullFvg := math.max(math.min(close, maxBullFvg), minBullFvg)

    // Bearish
    if bearFvg and newFvg.t != lastFvgT
        if fvgDynamic
            maxBearFvg := newFvg.max
            minBearFvg := newFvg.min
        else
            fvgAreas.unshift(box.new(bar_index - 2, newFvg.max, bar_index + fvgExt, newFvg.min,
                 border_color = fvgBordOn ? bearCss.tosolid() : na,
                 border_width = fvgBordW, border_style = lineStyle(fvgBordSt), bgcolor = bearCss))
        fvgRecords.unshift(newFvg)
        bearCount += 1
        lastFvgT  := newFvg.t
    else if fvgDynamic
        minBearFvg := math.min(math.max(close, minBearFvg), maxBearFvg)

    // Records and boxes are index-parallel (when not dynamic), so the oldest is
    // dropped from both together.
    if fvgRecords.size() > fvgMaxKeep
        fvgRecords.pop()
        if not fvgDynamic and fvgAreas.size() > 0
            oldest = fvgAreas.pop()
            oldest.delete()

// Mitigation: a gap dies when price CLOSES through its far edge.
if fvgRecords.size() > 0
    for i = fvgRecords.size() - 1 to 0
        rec = fvgRecords.get(i)
        bool gone = rec.isbull ? close < rec.min : close > rec.max
        if gone
            if fvgMitLines
                line.new(rec.t, rec.isbull ? rec.min : rec.max, time,
                     rec.isbull ? rec.min : rec.max, xloc.bar_time,
                     color = rec.isbull ? bullCss : bearCss,
                     style = lineStyle(fvgMitSt), width = fvgMitW)
            if not fvgDynamic and i < fvgAreas.size()
                area = fvgAreas.remove(i)
                area.delete()
            fvgRecords.remove(i)
            if rec.isbull
                bullMitigated += 1
            else
                bearMitigated += 1

// Levels on the most recent still-unmitigated gaps, redrawn each bar.
var array<line> unmitigated = array.new<line>(0)

if barstate.islast and fvgShowLast > 0 and fvgRecords.size() > 0
    if unmitigated.size() > 0
        for el in unmitigated
            el.delete()
        unmitigated.clear()
    for i = 0 to math.min(fvgShowLast - 1, fvgRecords.size() - 1)
        rec = fvgRecords.get(i)
        float y = rec.isbull ? rec.min : rec.max
        unmitigated.push(line.new(rec.t, y, time, y, xloc.bar_time,
             color = rec.isbull ? bullCss : bearCss,
             style = lineStyle(fvgUnmSt), width = fvgUnmW))

// Dynamic mode: one running zone per direction, filled between two hidden plots.
// Left as plain `color = na` rather than display.none, as in the original --
// the fill is anchored to these plots and this is the form known to work.
maxBullPlot = plot(maxBullFvg, "Dyn bull top", color = na)
minBullPlot = plot(minBullFvg, "Dyn bull btm", color = na)
fill(maxBullPlot, minBullPlot, color = bullCss)

maxBearPlot = plot(maxBearFvg, "Dyn bear top", color = na)
minBearPlot = plot(minBearFvg, "Dyn bear btm", color = na)
fill(maxBearPlot, minBearPlot, color = bearCss)

alertcondition(bullCount > bullCount[1], "Bullish FVG", "Bullish FVG detected")
alertcondition(bearCount > bearCount[1], "Bearish FVG", "Bearish FVG detected")
alertcondition(bullMitigated > bullMitigated[1], "Bullish FVG Mitigation", "Bullish FVG mitigated")
alertcondition(bearMitigated > bearMitigated[1], "Bearish FVG Mitigation", "Bearish FVG mitigated")

// ═════════════════════════════════════════════════════════════════════════════
// Previous D / W / M
// ═════════════════════════════════════════════════════════════════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

plot(pdOn ? pdh : na, "PDH", color = pdC, linewidth = pdW, style = plot.style_linebr)
plot(pdOn ? pdl : na, "PDL", color = pdC, linewidth = pdW, style = plot.style_linebr)
plot(pwOn ? pwh : na, "PWH", color = pwC, linewidth = pwW, style = plot.style_linebr)
plot(pwOn ? pwl : na, "PWL", color = pwC, linewidth = pwW, style = plot.style_linebr)
plot(pmOn ? pmh : na, "PMH", color = pmC, linewidth = pmW, style = plot.style_linebr)
plot(pmOn ? pml : na, "PML", color = pmC, linewidth = pmW, style = plot.style_linebr)

// ═════════════════════════════════════════════════════════════════════════════
// PD array
// ═════════════════════════════════════════════════════════════════════════════
var float dayHi = na
var float dayLo = na
if timeframe.change("D")
    dayHi := high
    dayLo := low
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low),  low)

rHi = switch pdaRange
    "Previous Day"   => pdh
    "Previous Week"  => pwh
    "Previous Month" => pmh
    => dayHi
rLo = switch pdaRange
    "Previous Day"   => pdl
    "Previous Week"  => pwl
    "Previous Month" => pml
    => dayLo

fib(float f) => na(rHi) or na(rLo) ? float(na) : rLo + (rHi - rLo) * f

plot(pdaOn                ? fib(1.000) : na, "Premium 1.0",  color = pdaBndC, style = plot.style_linebr)
plot(pdaOn                ? fib(0.705) : na, "OTE 0.705",    color = pdaOteC, style = plot.style_linebr)
plot(pdaOn and pdaSubOn   ? fib(0.618) : na, "0.618",        color = pdaSubC, style = plot.style_linebr)
plot(pdaOn                ? fib(0.500) : na, "EQ 0.5",       color = pdaEqC,  style = plot.style_linebr, linewidth = 2)
plot(pdaOn and pdaSubOn   ? fib(0.382) : na, "0.382",        color = pdaSubC, style = plot.style_linebr)
plot(pdaOn                ? fib(0.295) : na, "OTE 0.295",    color = pdaOteC, style = plot.style_linebr)
plot(pdaOn                ? fib(0.000) : na, "Discount 0.0", color = pdaBndC, style = plot.style_linebr)

// ═════════════════════════════════════════════════════════════════════════════
// SMT divergence
// ═════════════════════════════════════════════════════════════════════════════
// A swing on this chart is compared with the correlated symbol AT THE SAME
// BARS. If one makes a higher high and the other does not -- or one makes a
// lower low and the other does not -- the two markets disagree, and that
// disagreement is the signal.
smtAtr = ta.atr(200)

sym1 = smt1On ? smt1Sym : syminfo.tickerid
sym2 = smt2On ? smt2Sym : syminfo.tickerid
[c1h, c1l] = request.security(sym1, timeframe.period, [high, low],
     barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol = true)
[c2h, c2l] = request.security(sym2, timeframe.period, [high, low],
     barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol = true)

phv = ta.pivothigh(high, smtPiv, smtPiv)
plv = ta.pivotlow(low,  smtPiv, smtPiv)

var array<line>  smtLines = array.new<line>()
var array<label> smtLabs  = array.new<label>()

smtPush(line ln, label lb) =>
    array.push(smtLines, ln)
    array.push(smtLabs, lb)
    if array.size(smtLines) > smtKeep
        line.delete(array.shift(smtLines))
        label.delete(array.shift(smtLabs))

// Each call site of this function keeps its own copy of prevPiv/prevCorr/prevBar.
smtScan(float pivVal, float corrVal, bool isHigh, bool enabled, string tag, color col) =>
    var float prevPiv  = na
    var float prevCorr = na
    var int   prevBar  = na
    bool sig = false
    if not na(pivVal) and not na(corrVal)
        int  curBar = bar_index - smtPiv
        bool near   = smtMaxGap <= 0 or (curBar - prevBar) <= smtMaxGap
        if enabled and near and not na(prevPiv) and not na(prevCorr)
            bool chartHigher = pivVal  > prevPiv
            bool corrHigher  = corrVal > prevCorr
            if chartHigher != corrHigher
                sig := true
                float pad = nz(smtAtr, 0) * 0.5
                smtPush(
                     line.new(prevBar, prevPiv, curBar, pivVal, color = col,
                         width = smtWidth, style = lineStyle(smtStyle)),
                     label.new(math.round(math.avg(prevBar, curBar)),
                         isHigh ? math.max(prevPiv, pivVal) + pad : math.min(prevPiv, pivVal) - pad,
                         tag, style = label.style_none, textcolor = col,
                         size = lblSize(smtLblSize)))
        prevPiv  := pivVal
        prevCorr := corrVal
        prevBar  := curBar
    sig

smtHiCol = smtAutoCol ? chart.fg_color : smtBearCol
smtLoCol = smtAutoCol ? chart.fg_color : smtBullCol

smtB1 = smtScan(phv, c1h[smtPiv], true,  smtShow and smt1On, smtTag,       smtHiCol)
smtL1 = smtScan(plv, c1l[smtPiv], false, smtShow and smt1On, smtTag,       smtLoCol)
smtB2 = smtScan(phv, c2h[smtPiv], true,  smtShow and smt2On, smtTag + "2", smtHiCol)
smtL2 = smtScan(plv, c2l[smtPiv], false, smtShow and smt2On, smtTag + "2", smtLoCol)

smtBearSig = smtB1 or smtB2
smtBullSig = smtL1 or smtL2

var int smtCount = 0
if smtBearSig or smtBullSig
    smtCount += 1

alertcondition(smtBearSig, "Bearish SMT", "Bearish SMT divergence on {{ticker}} {{interval}}")
alertcondition(smtBullSig, "Bullish SMT", "Bullish SMT divergence on {{ticker}} {{interval}}")

// ═════════════════════════════════════════════════════════════════════════════
// Status table
// ═════════════════════════════════════════════════════════════════════════════
tblPos = switch dashPos
    "Bottom left" => position.bottom_left
    "Top right"   => position.top_right
    "Top left"    => position.top_left
    => position.bottom_right

var table dash = table.new(tblPos, 2, 9, border_width = 1)

dashRow(int r, string k, string v) =>
    table.cell(dash, 0, r, k, text_color = dashTxtCol, text_size = size.tiny,
         text_halign = text.align_left,  bgcolor = dashBgCol)
    table.cell(dash, 1, r, v, text_color = dashTxtCol, text_size = size.tiny,
         text_halign = text.align_right, bgcolor = dashBgCol)

px(float v) => na(v) ? "—" : str.tostring(v, format.mintick)

pct(int part, int whole) => whole > 0 ? str.tostring(part / whole * 100, format.percent) : "—"

// "CME_MINI:ES1!" -> "ES1!"
shortSym(string sy) =>
    parts = str.split(sy, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : sy

if dashOn and barstate.islast
    float eq = fib(0.5)
    dashRow(0, "ICT TOOLKIT",  timeframe.period)
    dashRow(1, "Session",      activeSes)
    dashRow(2, "SMT vs",       not smtShow ? "off" :
         shortSym(sym1) + (smt2On ? " / " + shortSym(sym2) : ""))
    dashRow(3, "SMT signals",  str.tostring(smtCount))
    dashRow(4, "FVG bull / bear", str.tostring(bullCount) + " / " + str.tostring(bearCount))
    dashRow(5, "FVG mitigated",   pct(bullMitigated, bullCount) + " / " + pct(bearMitigated, bearCount))
    dashRow(6, "PDH / PDL",    px(pdh) + " / " + px(pdl))
    dashRow(7, "PWH / PWL",    px(pwh) + " / " + px(pwl))
    dashRow(8, "PD bias",      na(eq) ? "—" : close > eq ? "Premium" : close < eq ? "Discount" : "EQ")

